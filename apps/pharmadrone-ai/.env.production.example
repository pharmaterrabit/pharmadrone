# Required production runtime configuration. Copy this file outside source
# control, replace every placeholder, and keep the resulting file secret.
APP_ENV=production
DATABASE_URL=postgresql://user:password@database-host:5432/pharmadrone
PHARMADRONE_AI_AUTH_SECRET=replace-with-a-long-random-production-secret
PHARMADRONE_AI_ALLOWED_ORIGINS=https://ai.example.com
PHARMADRONE_AI_API_DOCS=0

# Existing PharmaDrone server-side connector configuration. Leave an optional
# connector blank when it is not enabled; never expose these values to the web
# client or commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=
