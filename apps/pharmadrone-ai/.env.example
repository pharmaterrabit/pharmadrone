# Standalone PharmaDrone AI local/test configuration only.
APP_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_PATH=pharmadrone-ai.db
# Production: remove DATABASE_BACKEND/SQLITE_PATH and use the existing
# PostgreSQL-backed PharmaDrone intelligence database.
# DATABASE_URL=postgresql://user:password@host:5432/pharmadrone

# Required in production; generate a unique value of at least 32 characters.
PHARMADRONE_AI_AUTH_SECRET=replace-with-a-long-random-production-secret
PHARMADRONE_AI_ALLOWED_ORIGINS=http://localhost:8000
PHARMADRONE_AI_API_DOCS=1

# Existing server-side PharmaDrone connector configuration is reused. The
# browser never receives these values.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# TAVILY_API_KEY=
# EPO_OPS_CLIENT_ID=
# EPO_OPS_CLIENT_SECRET=

# Billing-ready configuration (checkout/webhook integration remains backlog work).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
