# Standalone PharmaDrone AI
APP_ENV=development
DATABASE_BACKEND=sqlite
SQLITE_PATH=pharmadrone-ai.db
# Production: use PostgreSQL instead of DATABASE_BACKEND/SQLITE_PATH.
# DATABASE_URL=postgresql://user:password@host:5432/pharmadrone

# Required in production; generate a unique value of at least 32 characters.
PHARMADRONE_AI_AUTH_SECRET=replace-with-a-long-random-production-secret
PHARMADRONE_AI_ALLOWED_ORIGINS=http://localhost:8000
PHARMADRONE_AI_API_DOCS=1
# Streamlit embeds this URL in its PharmaDrone AI navigation page.
PHARMADRONE_AI_URL=http://localhost:8000

# Optional tool-grounded response drafting. Deterministic mode works without these.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Billing-ready configuration (checkout/webhook integration remains backlog work).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
